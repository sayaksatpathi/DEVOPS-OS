#cloud-config
# FDE variant of the DevOS autoinstall: installs onto a LUKS-encrypted LVM layout.
# __PROFILES__, __PWHASH__, __LUKSPASS__ are filled by image/build-installer-iso.sh.
#
# SECURITY: the LUKS passphrase here is a build-time default for an EXPERIMENTAL image.
# A real deployment MUST set its own passphrase and store a recovery key safely. The
# installed account is forced to change its password on first login (chage -d 0).
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: devos
    username: devos
    password: "__PWHASH__"
  ssh:
    install-server: true
    allow-pw: true
  packages:
    - ansible-core
    - python3
  storage:
    layout:
      name: lvm
      password: "__LUKSPASS__"
      sizing-policy: all   # expand root LV to fill the VG (default leaves free space -> ENOSPC)
  late-commands:
    - "echo DEVOS_INSTALL_START_FDE > /dev/ttyS0"
    # warmup: ensure the (decrypted) target is mounted and writable, like the non-FDE path
    - "curtin in-target --target=/target -- bash -c 'mkdir -p /opt; true' && echo DEVOS_FDE_STEP_target_ok > /dev/ttyS0 || echo DEVOS_FDE_STEP_target_FAIL > /dev/ttyS0"
    - "cp /cdrom/devos-src.tar.gz /target/opt/devos-src.tar.gz && echo DEVOS_FDE_STEP_copy_ok > /dev/ttyS0 || echo DEVOS_FDE_STEP_copy_FAIL > /dev/ttyS0"
    - "mkdir -p /target/opt/devos && tar xzf /target/opt/devos-src.tar.gz -C /target/opt/devos && echo DEVOS_FDE_STEP_extract_ok > /dev/ttyS0 || echo DEVOS_FDE_STEP_extract_FAIL > /dev/ttyS0"
    - "curtin in-target --target=/target -- bash -c 'cd /opt/devos && for p in __PROFILES__; do PYTHONPATH=packages/cli DEVOS_ROOT=/opt/devos python3 -m devos profile apply $p --confirm; done' > /dev/ttyS0 2>&1 && echo DEVOS_FDE_STEP_apply_ok > /dev/ttyS0 || echo DEVOS_FDE_STEP_apply_FAIL > /dev/ttyS0"
    - "curtin in-target --target=/target -- bash -c 'cp /opt/devos/image/autoinstall/grub-serial.cfg /etc/default/grub.d/99-devos-serial.cfg && update-grub' > /dev/ttyS0 2>&1 && echo DEVOS_FDE_STEP_serial_ok > /dev/ttyS0 || echo DEVOS_FDE_STEP_serial_FAIL > /dev/ttyS0"
    - "curtin in-target --target=/target -- chage -d 0 devos"
    - "echo DEVOS_INSTALL_OK > /dev/ttyS0"
  shutdown: poweroff
