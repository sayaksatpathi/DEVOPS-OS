# Pinned base image for DevOS cloud-image builds.
#
# We build on Ubuntu's OFFICIAL 26.04 (resolute) server cloud image (a qcow2 despite
# the .img extension). The checksum is verified at build time against the official
# SHA256SUMS published alongside the image (fetched over HTTPS). This keeps the base
# input verifiable without hard-coding a digest that goes stale on every respin.
#
# NOTE: for a signed release we must additionally GPG-verify SHA256SUMS against the
# Ubuntu Cloud Image signing key (see docs/build-and-release.md). The build script
# attempts this and warns if the key is unavailable, rather than failing the dev build.

BASE_FILE="ubuntu-26.04-server-cloudimg-amd64.img"
BASE_URL="https://cloud-images.ubuntu.com/releases/resolute/release/ubuntu-26.04-server-cloudimg-amd64.img"
BASE_SHA256SUMS_URL="https://cloud-images.ubuntu.com/releases/resolute/release/SHA256SUMS"
BASE_SHA256SUMS_GPG_URL="https://cloud-images.ubuntu.com/releases/resolute/release/SHA256SUMS.gpg"
# Ubuntu Cloud Image signing key fingerprint (verify before trusting SHA256SUMS).
UBUNTU_CLOUDIMAGE_KEY_FPR="D2EB44626FDDC30B513D5BB71A5D6C4C7DB87C81"
