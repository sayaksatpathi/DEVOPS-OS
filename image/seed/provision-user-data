#cloud-config
# PROVISION seed: on first boot of the base cloud image, install ansible-core and run
# `devos profile apply` for the selected profiles (baking the tools into the disk),
# then lock versions, write a marker to the serial console, and power off. Network
# (DNS) works here because qemu user-mode networking provides DHCP + a DNS forwarder.
# __PROFILES__ is replaced by the build script with space-separated profile names.
runcmd:
  - [ bash, -c, "set -x; apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y ansible-core python3 > /dev/ttyS0 2>&1 || { echo DEVOS_PROVISION_FAIL_apt > /dev/ttyS0; }" ]
  - [ bash, -c, "cd /opt/devos && for p in __PROFILES__; do PYTHONPATH=packages/cli DEVOS_ROOT=/opt/devos python3 -m devos profile apply $p --confirm > /dev/ttyS0 2>&1 || echo DEVOS_PROVISION_FAIL_apply_$p > /dev/ttyS0; done" ]
  - [ bash, -c, "cd /opt/devos && for p in __PROFILES__; do PYTHONPATH=packages/cli DEVOS_ROOT=/opt/devos python3 -m devos profile lock $p > /dev/ttyS0 2>&1 || true; done" ]
  - [ bash, -c, "cd /opt/devos && ANSIBLE_ROLES_PATH=/opt/devos/provision/ansible/roles ANSIBLE_HOST_KEY_CHECKING=False ansible-playbook -i localhost, -c local provision/ansible/playbooks/harden.yml > /dev/ttyS0 2>&1 && echo DEVOS_HARDENED_OK > /dev/ttyS0 || echo DEVOS_HARDEN_FAIL > /dev/ttyS0" ]
  - [ bash, -c, "if command -v podman >/dev/null 2>&1; then (podman run --rm quay.io/podman/hello >/dev/ttyS0 2>&1 || podman run --rm docker.io/library/hello-world >/dev/ttyS0 2>&1) && echo DEVOS_CONTAINER_RUN_OK > /dev/ttyS0 || echo DEVOS_CONTAINER_RUN_FAIL > /dev/ttyS0; fi" ]
  - [ bash, -c, "mkdir -p /var/lib/devos; { echo -e \"devos-engine\\t0.1.0\"; for b in tofu kubectl helm; do command -v $b >/dev/null 2>&1 && echo -e \"$b\\t$($b version 2>/dev/null | head -1 | tr -d '\\t')\"; done; } > /var/lib/devos/extra-components.tsv" ]
  - [ bash, -c, "cd /opt/devos && PYTHONPATH=packages/cli DEVOS_ROOT=/opt/devos python3 -m devos profile apply core --confirm 2>&1 | grep -q 'changed=0' && echo DEVOS_IDEMPOTENT_OK > /dev/ttyS0 || echo DEVOS_IDEMPOTENT_FAIL > /dev/ttyS0" ]
  - [ bash, -c, "mkdir -p /var/lib/devos && dpkg-query -W -f='${Package}\\t${Version}\\n' > /var/lib/devos/packages.tsv 2>/dev/null; echo DEVOS_SBOM_WRITTEN > /dev/ttyS0" ]
  - [ bash, -c, "mkdir -p /var/lib/devos && date -u +%FT%TZ > /var/lib/devos/provisioned && echo DEVOS_PROVISION_OK > /dev/ttyS0" ]
power_state:
  mode: poweroff
  timeout: 30
  condition: true
